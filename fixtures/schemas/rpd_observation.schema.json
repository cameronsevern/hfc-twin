{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpdObservation",
  "description": "What one RPD shows at one time step.",
  "type": "object",
  "properties": {
    "drawing_power": {
      "description": "Whether its supply sees it drawing power: the difference between a dead RPD and a cut fiber.",
      "type": "boolean"
    },
    "element_id": {
      "description": "The RPD.",
      "$ref": "#/$defs/ElementId"
    },
    "gcp_status": {
      "description": "Its control plane.",
      "$ref": "#/$defs/GcpStatus"
    },
    "origin": {
      "description": "Whether this is simulated or measured (invariant 11).",
      "$ref": "#/$defs/Origin"
    },
    "ptp_result": {
      "description": "Its timing.",
      "$ref": "#/$defs/PtpResult"
    },
    "rf_output_up": {
      "description": "Whether its RF port is passing signal.",
      "type": "boolean"
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "t": {
      "description": "Simulated time, seconds.",
      "$ref": "#/$defs/Timestamp"
    },
    "top_level_state": {
      "description": "Its state.",
      "$ref": "#/$defs/RpdState"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "t",
    "origin",
    "element_id",
    "top_level_state",
    "gcp_status",
    "ptp_result",
    "rf_output_up",
    "drawing_power"
  ],
  "$defs": {
    "ElementId": {
      "description": "A plant element or power supply, such as `amp-1`.",
      "type": "string"
    },
    "GcpStatus": {
      "description": "`RpdGcpConnectionStatus`.",
      "oneOf": [
        {
          "description": "Connected.",
          "type": "string",
          "const": "Connected"
        },
        {
          "description": "Trying again.",
          "type": "string",
          "const": "Reconnecting"
        },
        {
          "description": "Not trying.",
          "type": "string",
          "const": "Inactive"
        }
      ]
    },
    "Origin": {
      "description": "Whether a plant or observation is simulated or measured (invariant 11).",
      "oneOf": [
        {
          "description": "Generated by this project; never to be presented as real.",
          "type": "string",
          "const": "Synthetic"
        },
        {
          "description": "Measured on, or imported from, a real network.",
          "type": "string",
          "const": "Field"
        }
      ]
    },
    "PtpResult": {
      "description": "`PtpResult` [R-PHY §B.5].",
      "oneOf": [
        {
          "description": "Locked.",
          "type": "string",
          "const": "Synchronized"
        },
        {
          "description": "Holding over, in spec.",
          "type": "string",
          "const": "HoldoverWithinSpec"
        },
        {
          "description": "Holding over, out of spec.",
          "type": "string",
          "const": "HoldoverOutOfSpec"
        },
        {
          "description": "Nothing to go on: not reachable, or not started.",
          "type": "string",
          "const": "FreeRunning"
        }
      ]
    },
    "RpdState": {
      "description": "`TopLevelRPDState`, as far as this model moves through it.",
      "oneOf": [
        {
          "description": "Running.",
          "type": "string",
          "const": "Operational"
        },
        {
          "description": "Starting up.",
          "type": "string",
          "const": "Initializing"
        },
        {
          "description": "Not reachable.",
          "type": "string",
          "const": "Offline"
        }
      ]
    },
    "Timestamp": {
      "description": "Simulated time in seconds, passed in and never read from the system clock\n(invariant 4). t = 0 is midnight on the simulated day (§8).",
      "type": "integer",
      "format": "int64"
    }
  }
}
