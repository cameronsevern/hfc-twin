{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreetMap",
  "description": "The geography a design starts from.",
  "type": "object",
  "properties": {
    "headend": {
      "description": "Where fiber comes from: the hub's site.",
      "$ref": "#/$defs/LonLat"
    },
    "homes": {
      "description": "Homes passed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Home"
      }
    },
    "id": {
      "description": "Stable identifier.",
      "type": "string"
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "source": {
      "description": "Where it came from.",
      "$ref": "#/$defs/MapSource"
    },
    "streets": {
      "description": "Roads.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Street"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source",
    "streets",
    "homes",
    "headend"
  ],
  "$defs": {
    "Home": {
      "description": "A home passed.",
      "type": "object",
      "properties": {
        "geo": {
          "description": "Where it is.",
          "$ref": "#/$defs/LonLat"
        },
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "geo"
      ]
    },
    "Installation": {
      "description": "How a span is installed; it selects the §1.2 temperature.",
      "oneOf": [
        {
          "description": "Strung on poles: follows `temp_c`.",
          "type": "string",
          "const": "Aerial"
        },
        {
          "description": "Buried: follows `ground_temp_c`.",
          "type": "string",
          "const": "Underground"
        }
      ]
    },
    "LayoutFamily": {
      "description": "A layout family: held out by family, never by random sample, when evaluating models (`docs/DESIGN.md`).",
      "oneOf": [
        {
          "description": "Short blocks on a grid, dense lots, aerial.",
          "type": "string",
          "const": "UrbanGrid"
        },
        {
          "description": "Arterials and cul-de-sacs, underground.",
          "type": "string",
          "const": "Suburban"
        },
        {
          "description": "Long roads, few homes, aerial.",
          "type": "string",
          "const": "Rural"
        }
      ]
    },
    "LonLat": {
      "description": "A geographic position.",
      "type": "object",
      "properties": {
        "lat_deg": {
          "description": "Latitude in degrees, WGS 84.",
          "type": "number",
          "format": "double"
        },
        "lon_deg": {
          "description": "Longitude in degrees, WGS 84.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "lon_deg",
        "lat_deg"
      ]
    },
    "MapSource": {
      "description": "Where a map came from.",
      "oneOf": [
        {
          "description": "Generated by this project: the geography is as invented as the plant.",
          "type": "object",
          "properties": {
            "Generated": {
              "type": "object",
              "properties": {
                "family": {
                  "description": "Its family.",
                  "$ref": "#/$defs/LayoutFamily"
                },
                "seed": {
                  "description": "The seed that drew it.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "family",
                "seed"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Generated"
          ]
        },
        {
          "description": "OpenStreetMap: real geography, with an invented plant on it.",
          "type": "object",
          "properties": {
            "OpenStreetMap": {
              "type": "object",
              "properties": {
                "attribution": {
                  "description": "Attribution the license requires.",
                  "type": "string"
                }
              },
              "required": [
                "attribution"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "OpenStreetMap"
          ]
        }
      ]
    },
    "Street": {
      "description": "A road a cable can follow.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "installation": {
          "description": "How plant runs along it.",
          "$ref": "#/$defs/Installation"
        },
        "points": {
          "description": "Its centerline.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LonLat"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "points",
        "installation"
      ]
    }
  }
}
