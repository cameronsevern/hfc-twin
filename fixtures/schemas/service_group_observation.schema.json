{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceGroupObservation",
  "description": "What one service group shows at one time step.",
  "type": "object",
  "properties": {
    "optics": {
      "description": "The node's optics, where the plant reports them (§16). Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/OpticsObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "description": "Whether this is simulated or measured (invariant 11).",
      "$ref": "#/$defs/Origin"
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "service_group": {
      "description": "The service group.",
      "$ref": "#/$defs/ServiceGroupId"
    },
    "t": {
      "description": "Simulated time, seconds.",
      "$ref": "#/$defs/Timestamp"
    },
    "us_codewords": {
      "description": "Codeword counts per upstream channel.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsCodewordRecord"
      }
    },
    "us_snr": {
      "description": "SNR per upstream channel.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsSnrRecord"
      }
    },
    "us_spectrum": {
      "description": "Upstream spectrum capture per RF port.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/UsSpectrumRecord"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "t",
    "origin",
    "service_group",
    "us_snr",
    "us_codewords"
  ],
  "$defs": {
    "ChannelId": {
      "description": "A channel in a channel plan, stable across migrations (§9).",
      "type": "string"
    },
    "OpticStatus": {
      "description": "One pluggable optic's status (§16). Version 2.",
      "type": "object",
      "properties": {
        "link_up": {
          "description": "Whether its receive power is between sensitivity and overload.",
          "type": "boolean"
        },
        "rx_dbm": {
          "description": "Its receive power, dBm, or `None` with no light.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "tx_dbm": {
          "description": "Its launch power, dBm.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "link_up",
        "tx_dbm"
      ]
    },
    "OpticsObservation": {
      "description": "A node's optics as its devices report them (§16). Each field is `None` where its flag is off or nothing reports it.\nVersion 2.",
      "type": "object",
      "properties": {
        "hub_rx_dbm": {
          "description": "Light into the hub's return receiver or optic, dBm: `heOpRxInputPower`, or the hub optic's receive power.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "node_rx_dbm": {
          "description": "Light into the node's forward receiver or RPD optic, dBm: `fnOpticalReceiverPower` on an analog node, an RPD optic's\nreceive power.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rpd_optic": {
          "description": "An RPD's primary optic.",
          "anyOf": [
            {
              "$ref": "#/$defs/OpticStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Origin": {
      "description": "Whether a plant or observation is simulated or measured (invariant 11).",
      "oneOf": [
        {
          "description": "Generated by this project; never to be presented as real.",
          "type": "string",
          "const": "Synthetic"
        },
        {
          "description": "Measured on, or imported from, a real network.",
          "type": "string",
          "const": "Field"
        }
      ]
    },
    "PortId": {
      "description": "A port on one element, such as `tap-1` or `through`.",
      "type": "string"
    },
    "ProfileId": {
      "description": "An architecture profile.",
      "type": "string"
    },
    "ServiceGroupId": {
      "description": "A service group: one node's tree.",
      "type": "string"
    },
    "Timestamp": {
      "description": "Simulated time in seconds, passed in and never read from the system clock\n(invariant 4). t = 0 is midnight on the simulated day (§8).",
      "type": "integer",
      "format": "int64"
    },
    "UsCodewordRecord": {
      "description": "`us_codewords` for one upstream channel, per interval, as the CMTS counts them.",
      "type": "object",
      "properties": {
        "channel_id": {
          "description": "The upstream channel.",
          "$ref": "#/$defs/ChannelId"
        },
        "corrected": {
          "description": "Codewords corrected.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "profile_ref": {
          "description": "The architecture profile in force.",
          "$ref": "#/$defs/ProfileId"
        },
        "total": {
          "description": "Codewords received.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "uncorrectable": {
          "description": "Codewords uncorrectable.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "channel_id",
        "profile_ref",
        "total",
        "corrected",
        "uncorrectable"
      ]
    },
    "UsSnrRecord": {
      "description": "`us_snr_db` for one upstream channel (§7.3).",
      "type": "object",
      "properties": {
        "channel_id": {
          "description": "The upstream channel.",
          "$ref": "#/$defs/ChannelId"
        },
        "profile_ref": {
          "description": "The architecture profile in force.",
          "$ref": "#/$defs/ProfileId"
        },
        "us_snr_db": {
          "description": "SNR at the CMTS, dB.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "channel_id",
        "profile_ref",
        "us_snr_db"
      ]
    },
    "UsSpectrumRecord": {
      "description": "One upstream spectrum capture of `N_node(f)` and carriers, on one RF port (§7.3).",
      "type": "object",
      "properties": {
        "bin_width_khz": {
          "description": "Bin spacing, kHz.",
          "type": "number",
          "format": "double"
        },
        "first_bin_center_mhz": {
          "description": "Centre of the first bin, MHz.",
          "type": "number",
          "format": "double"
        },
        "noise_bandwidth_khz": {
          "description": "Equivalent noise bandwidth of one bin, kHz.",
          "type": "number",
          "format": "double"
        },
        "port": {
          "description": "The RF port on the root element.",
          "$ref": "#/$defs/PortId"
        },
        "profile_ref": {
          "description": "The architecture profile in force.",
          "$ref": "#/$defs/ProfileId"
        },
        "us_spectrum_dbmv": {
          "description": "Level per bin, dBmV in `noise_bandwidth_khz`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "port",
        "profile_ref",
        "first_bin_center_mhz",
        "bin_width_khz",
        "noise_bandwidth_khz",
        "us_spectrum_dbmv"
      ]
    }
  }
}
