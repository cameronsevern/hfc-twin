{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignRules",
  "description": "One design specification.",
  "type": "object",
  "properties": {
    "branching": {
      "description": "How a line branches away from an active. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/BranchRules"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "description": "The alternatives a design's candidate set tries. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRules"
        },
        {
          "type": "null"
        }
      ]
    },
    "conditioning": {
      "description": "Tap conditioners and line equalizers. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/ConditioningRules"
        },
        {
          "type": "null"
        }
      ]
    },
    "costs": {
      "description": "What things cost.",
      "$ref": "#/$defs/CostTable"
    },
    "drops": {
      "description": "Drop cable by length, shortest reach first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DropRule"
      }
    },
    "end_of_line": {
      "description": "How a line ends.",
      "$ref": "#/$defs/EndOfLine"
    },
    "fiber": {
      "description": "Fiber.",
      "$ref": "#/$defs/FiberRules"
    },
    "fittings": {
      "description": "Connectors and splices on cable. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/FittingRules"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Stable id.",
      "type": "string"
    },
    "node": {
      "description": "Node size and port use.",
      "$ref": "#/$defs/NodeRules"
    },
    "powering": {
      "description": "Powering.",
      "$ref": "#/$defs/PoweringRules"
    },
    "premises": {
      "description": "What's in a home, and how often.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PremisesTemplate"
      }
    },
    "premises_allowance": {
      "description": "What the design leaves for the drop and the home.",
      "$ref": "#/$defs/PremisesAllowance"
    },
    "premises_parts": {
      "description": "The parts in a home, and what an unused tap port gets. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/PremisesParts"
        },
        {
          "type": "null"
        }
      ]
    },
    "profiles": {
      "description": "What the rules say per profile: the root, station levels, premises allowed and optics. Version 2.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ProfileRules"
      }
    },
    "roles": {
      "description": "Cable and amp by the role of the line.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoleRule"
      }
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "structures": {
      "description": "Structures along routes.",
      "$ref": "#/$defs/StructureRules"
    },
    "tap_families": {
      "description": "The taps a design may place, by port count.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TapFamily"
      }
    },
    "tap_port": {
      "description": "Level at the tap port, per profile.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TapPortTarget"
      }
    },
    "upgrade": {
      "description": "The moves an upgrade in place may make. Version 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/UpgradeRules"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tap_port",
    "premises_allowance",
    "end_of_line",
    "tap_families",
    "roles",
    "drops",
    "node",
    "powering",
    "structures",
    "premises",
    "fiber",
    "costs"
  ],
  "$defs": {
    "Basis": {
      "description": "Where a rule's value comes from (invariant 9, for rules).",
      "oneOf": [
        {
          "description": "A reference note that cites a public document: `file.md §section`.",
          "type": "object",
          "properties": {
            "Sourced": {
              "type": "object",
              "properties": {
                "note": {
                  "description": "The note and section, such as `design-practice.md §2`.",
                  "type": "string"
                }
              },
              "required": [
                "note"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Sourced"
          ]
        },
        {
          "description": "Typical, or from memory. To confirm.",
          "type": "string",
          "const": "Generic"
        }
      ]
    },
    "BranchRules": {
      "description": "How a line branches away from an active. Version 2.",
      "type": "object",
      "properties": {
        "couplers": {
          "description": "Couplers for an unequal one, `DirectionalCoupler`.",
          "$ref": "#/$defs/Ruled4"
        },
        "splitter_ref": {
          "description": "The splitter for an equal branch, a two-leg `Splitter`.",
          "$ref": "#/$defs/Ruled5"
        }
      },
      "additionalProperties": false,
      "required": [
        "splitter_ref",
        "couplers"
      ]
    },
    "CandidateRules": {
      "description": "The alternatives a design's candidate set tries. Version 2.",
      "type": "object",
      "properties": {
        "express_cables": {
          "description": "Express cables tried, `Cable`. The express role's own is always tried.",
          "$ref": "#/$defs/Ruled4"
        },
        "node_count_steps": {
          "description": "Node counts tried, as steps from the count the homes per node target gives.",
          "$ref": "#/$defs/Ruled14"
        }
      },
      "additionalProperties": false,
      "required": [
        "node_count_steps",
        "express_cables"
      ]
    },
    "ComponentId": {
      "description": "A component library entry.",
      "type": "string"
    },
    "ConditioningRules": {
      "description": "Tap conditioners and line equalizers. Version 2.",
      "type": "object",
      "properties": {
        "conditioners": {
          "description": "Tap conditioners, `PlugIn` parts of kind `TapConditioner`, any value.",
          "$ref": "#/$defs/Ruled4"
        },
        "line_equalizers": {
          "description": "Line equalizers, `LineEqualizer`.",
          "$ref": "#/$defs/Ruled4"
        }
      },
      "additionalProperties": false,
      "required": [
        "conditioners",
        "line_equalizers"
      ]
    },
    "ConstructionCost": {
      "description": "One kind of construction's cost.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "What's built.",
          "$ref": "#/$defs/ConstructionKind"
        },
        "usd_per_ft": {
          "description": "Per foot, US dollars.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "usd_per_ft"
      ]
    },
    "ConstructionKind": {
      "description": "The kinds of construction priced by the foot.",
      "oneOf": [
        {
          "description": "Lashing hardline to strand.",
          "type": "string",
          "const": "AerialCoax"
        },
        {
          "description": "Burying hardline in conduit.",
          "type": "string",
          "const": "UndergroundCoax"
        },
        {
          "description": "Lashing fiber to strand.",
          "type": "string",
          "const": "AerialFiber"
        },
        {
          "description": "Burying fiber in conduit.",
          "type": "string",
          "const": "UndergroundFiber"
        },
        {
          "description": "An aerial drop.",
          "type": "string",
          "const": "AerialDrop"
        },
        {
          "description": "A buried drop.",
          "type": "string",
          "const": "BuriedDrop"
        }
      ]
    },
    "CostTable": {
      "description": "What things cost, in US dollars.",
      "type": "object",
      "properties": {
        "ceiling_usd_per_home": {
          "description": "The most a design spends per home passed before it says coax isn't the answer for those homes, US dollars.\nVersion 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled"
            },
            {
              "type": "null"
            }
          ]
        },
        "construction": {
          "description": "Per foot of construction.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstructionCost"
          }
        },
        "parts": {
          "description": "Per part, installed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartCost"
          }
        },
        "plug_in_families": {
          "description": "Plug-ins, by family. Version 2.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/FamilyCost"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "parts",
        "construction"
      ]
    },
    "CpeDevice": {
      "description": "What a piece of customer equipment is.",
      "oneOf": [
        {
          "description": "A set-top box.",
          "type": "string",
          "const": "SetTop"
        },
        {
          "description": "A television tuned directly from the coax.",
          "type": "string",
          "const": "Television"
        },
        {
          "description": "An in-home network adapter.",
          "type": "string",
          "const": "MocaAdapter"
        },
        {
          "description": "Anything else on a port.",
          "type": "string",
          "const": "Other"
        }
      ]
    },
    "CpeRef": {
      "description": "The part for one kind of customer device. Version 2.",
      "type": "object",
      "properties": {
        "component_ref": {
          "description": "The part, a `Cpe`.",
          "$ref": "#/$defs/ComponentId"
        },
        "device": {
          "description": "The device.",
          "$ref": "#/$defs/CpeDevice"
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "component_ref"
      ]
    },
    "DropRule": {
      "description": "Drop cable up to a length.",
      "type": "object",
      "properties": {
        "cable_ref": {
          "description": "The cable, a `Drop`.",
          "$ref": "#/$defs/Ruled5"
        },
        "max_len_ft": {
          "description": "Longest drop this cable is used for, feet.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_len_ft",
        "cable_ref"
      ]
    },
    "EndOfLine": {
      "description": "How a line ends.",
      "type": "object",
      "properties": {
        "last_tap_terminating": {
          "description": "Whether the last tap on a line is a terminating tap.",
          "$ref": "#/$defs/Ruled2"
        },
        "min_port_dbmv_at_hi": {
          "description": "The lowest a last tap's port may be at the top forward frequency, dBmV per 6 MHz.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "last_tap_terminating",
        "min_port_dbmv_at_hi"
      ]
    },
    "FamilyCost": {
      "description": "What a plug-in of one family costs, any value. Version 2.",
      "type": "object",
      "properties": {
        "family": {
          "description": "The family, as a `PlugIn` part states it.",
          "type": "string"
        },
        "usd": {
          "description": "Each, US dollars.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "usd"
      ]
    },
    "FiberRules": {
      "description": "Fiber.",
      "type": "object",
      "properties": {
        "cable_counts": {
          "description": "Fiber counts cable comes in.",
          "$ref": "#/$defs/Ruled9"
        },
        "cable_refs": {
          "description": "Outside fiber cable by count, each a `FiberCable` whose count is one of `cable_counts`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled4"
            },
            {
              "type": "null"
            }
          ]
        },
        "closure_ref": {
          "description": "The splice closure, a `SpliceClosure`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "composite_index_max": {
          "description": "The most an analog forward link's per-channel modulation index may be, times the square root of the channels\nloaded: the composite a transmitter is chosen to stay under, clear of clipping. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled"
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_loss_db": {
          "description": "Allowance per mated connector pair, dB.",
          "$ref": "#/$defs/Ruled"
        },
        "connector_ref": {
          "description": "The connector on every mated pair, a `FiberConnector`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "duplex_jumper_ref": {
          "description": "A two-fiber jumper in the hub, for a duplex optic, a `FiberCable`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "fibers_per_analog_node": {
          "description": "Fibers per analog node.",
          "$ref": "#/$defs/Ruled6"
        },
        "fibers_per_rpd": {
          "description": "Fibers per RPD.",
          "$ref": "#/$defs/Ruled6"
        },
        "jumper_len_ft": {
          "description": "A jumper's length, feet. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled"
            },
            {
              "type": "null"
            }
          ]
        },
        "jumper_ref": {
          "description": "A one-fiber jumper in the hub, a `FiberCable`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "link_margin_db": {
          "description": "Margin a link budget keeps, dB.",
          "$ref": "#/$defs/Ruled"
        },
        "panel_ref": {
          "description": "The hub's patch panel, a `PatchPanel`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "reel_len_ft": {
          "description": "Longest continuous cable, feet: a splice closure at least this often.",
          "$ref": "#/$defs/Ruled"
        },
        "splice_loss_db": {
          "description": "Allowance per fusion splice, dB.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "fibers_per_analog_node",
        "fibers_per_rpd",
        "cable_counts",
        "reel_len_ft",
        "link_margin_db",
        "splice_loss_db",
        "connector_loss_db"
      ]
    },
    "FittingRules": {
      "description": "Connectors and splices on cable. Version 2.",
      "type": "object",
      "properties": {
        "connectors": {
          "description": "Connectors and splices, `Connector` parts. A cable takes the one whose family is its own, and a drop the `DropF`.",
          "$ref": "#/$defs/Ruled4"
        },
        "hardline_reel_len_ft": {
          "description": "Longest hardline between splices, feet.",
          "$ref": "#/$defs/Ruled"
        },
        "jumper_len_ft": {
          "description": "The hardline jumper between two housings at one structure, feet: the one span a design lays shorter than a run.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "connectors",
        "hardline_reel_len_ft",
        "jumper_len_ft"
      ]
    },
    "LineRole": {
      "description": "The role of a line.",
      "oneOf": [
        {
          "description": "Carries signal to amps, with no taps.",
          "type": "string",
          "const": "Express"
        },
        {
          "description": "Feeds taps.",
          "type": "string",
          "const": "Feeder"
        }
      ]
    },
    "NodeOptics": {
      "description": "A node's optics and what serves it in the hub. Each list is in order of preference: the designer takes the first\ncombination that `sim::optics` passes with the rules' margin. Version 2.",
      "oneOf": [
        {
          "description": "An analog node behind an integrated CMTS.",
          "type": "object",
          "properties": {
            "Analog": {
              "type": "object",
              "properties": {
                "cmts_ref": {
                  "description": "The CMTS, a `Cmts`.",
                  "$ref": "#/$defs/ComponentId"
                },
                "forward_tx": {
                  "description": "Forward transmitters in the hub, `OpticalTx`.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                },
                "hub_amps": {
                  "description": "Optical amplifiers in the hub after a 1550 nm forward transmitter, `OpticalAmp`, tried after none: links\nbeyond about 25 km need one (fiber-optics.md §7).",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                },
                "hub_couplers": {
                  "description": "Hub couplers between a forward transmitter and its fiber, `OpticalPassive`, tried after none.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                },
                "hub_rx": {
                  "description": "Return receivers in the hub, `OpticalRx`.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                },
                "node_rx": {
                  "description": "The node's forward receiver, `OpticalRx`.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                },
                "return_tx": {
                  "description": "The node's return laser, `OpticalTx`.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                }
              },
              "required": [
                "cmts_ref",
                "forward_tx",
                "hub_couplers",
                "node_rx",
                "return_tx",
                "hub_rx"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Analog"
          ]
        },
        {
          "description": "A Remote PHY device on the converged interconnect network.",
          "type": "object",
          "properties": {
            "Digital": {
              "type": "object",
              "properties": {
                "core_ref": {
                  "description": "The Remote PHY core, a `Cmts`.",
                  "$ref": "#/$defs/ComponentId"
                },
                "switch_ref": {
                  "description": "The switch, a `Switch`.",
                  "$ref": "#/$defs/ComponentId"
                },
                "timing_ref": {
                  "description": "The timing source, a `TimingSource`.",
                  "$ref": "#/$defs/ComponentId"
                },
                "transceivers": {
                  "description": "The optic at both ends, `Transceiver`.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComponentId"
                  }
                }
              },
              "required": [
                "core_ref",
                "switch_ref",
                "transceivers",
                "timing_ref"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Digital"
          ]
        }
      ]
    },
    "NodeRules": {
      "description": "Node size and port use.",
      "type": "object",
      "properties": {
        "max_actives": {
          "description": "Actives below the node, at most, the node not counted. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled6"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_cascade": {
          "description": "Amps in cascade below the node, at most.",
          "$ref": "#/$defs/Ruled7"
        },
        "max_homes": {
          "description": "Homes passed per node, at most.",
          "$ref": "#/$defs/Ruled6"
        },
        "rf_ports": {
          "description": "RF ports used.",
          "$ref": "#/$defs/Ruled7"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_homes",
        "rf_ports",
        "max_cascade"
      ]
    },
    "PartCost": {
      "description": "One part's cost.",
      "type": "object",
      "properties": {
        "component_ref": {
          "description": "The part.",
          "$ref": "#/$defs/ComponentId"
        },
        "usd": {
          "description": "Each, US dollars.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "component_ref",
        "usd"
      ]
    },
    "PoweringRules": {
      "description": "Powering.",
      "type": "object",
      "properties": {
        "batteries_per_string": {
          "description": "Batteries in series per string.",
          "$ref": "#/$defs/Ruled7"
        },
        "battery_ref": {
          "description": "The battery, a `Battery`.",
          "$ref": "#/$defs/Ruled5"
        },
        "battery_strings": {
          "description": "Strings per supply.",
          "$ref": "#/$defs/Ruled7"
        },
        "design_load_pct": {
          "description": "Share of a supply's rating a design may load it to, percent.",
          "$ref": "#/$defs/Ruled"
        },
        "inserter_ref": {
          "description": "The power inserter a supply feeds, a `PowerInserter`. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled5"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_margin_v": {
          "description": "Volts each active keeps above its part's minimum input, at both temperatures. Version 2.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ruled"
            },
            {
              "type": "null"
            }
          ]
        },
        "port_max_a": {
          "description": "Most current through one power inserter or active port, amps.",
          "$ref": "#/$defs/Ruled"
        },
        "supply_ref": {
          "description": "The supply, a `PowerSupply`.",
          "$ref": "#/$defs/Ruled5"
        }
      },
      "additionalProperties": false,
      "required": [
        "supply_ref",
        "design_load_pct",
        "port_max_a",
        "battery_ref",
        "batteries_per_string",
        "battery_strings"
      ]
    },
    "PremisesAllowance": {
      "description": "The loss the design leaves between the tap port and the device, at the top forward frequency.",
      "type": "object",
      "properties": {
        "drop_loss_db": {
          "description": "For the drop, dB.",
          "$ref": "#/$defs/Ruled"
        },
        "house_loss_db": {
          "description": "For the ground block, in-home splitting and cable, dB.",
          "$ref": "#/$defs/Ruled"
        }
      },
      "additionalProperties": false,
      "required": [
        "drop_loss_db",
        "house_loss_db"
      ]
    },
    "PremisesParts": {
      "description": "The parts in a home, and what an unused tap port gets. Version 2.",
      "type": "object",
      "properties": {
        "cpe_refs": {
