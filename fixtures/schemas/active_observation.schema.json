{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActiveObservation",
  "description": "What one active reports at one time step, where the hardware reports it.",
  "type": "object",
  "properties": {
    "element_id": {
      "description": "The active.",
      "$ref": "#/$defs/ElementId"
    },
    "i_draw": {
      "description": "Current draw, amps.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "origin": {
      "description": "Whether this is simulated or measured (invariant 11).",
      "$ref": "#/$defs/Origin"
    },
    "out_level": {
      "description": "Output level.",
      "anyOf": [
        {
          "$ref": "#/$defs/OutLevel"
        },
        {
          "type": "null"
        }
      ]
    },
    "out_levels": {
      "description": "Output level at each output port, where the active reports one per port (`rfAmpRFPortOutputRFLevel`). Version 2.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PortOutLevel"
      }
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "status": {
      "description": "Operating status.",
      "anyOf": [
        {
          "$ref": "#/$defs/ActiveStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "t": {
      "description": "Simulated time, seconds.",
      "$ref": "#/$defs/Timestamp"
    },
    "temp_c": {
      "description": "Device temperature, °C.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "v_in": {
      "description": "Input voltage, volts.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "t",
    "origin",
    "element_id"
  ],
  "$defs": {
    "ActiveStatus": {
      "description": "An active's operating status.",
      "oneOf": [
        {
          "description": "Running.",
          "type": "string",
          "const": "Up"
        },
        {
          "description": "Not running: failed or browned out.",
          "type": "string",
          "const": "Down"
        }
      ]
    },
    "ElementId": {
      "description": "A plant element or power supply, such as `amp-1`.",
      "type": "string"
    },
    "Origin": {
      "description": "Whether a plant or observation is simulated or measured (invariant 11).",
      "oneOf": [
        {
          "description": "Generated by this project; never to be presented as real.",
          "type": "string",
          "const": "Synthetic"
        },
        {
          "description": "Measured on, or imported from, a real network.",
          "type": "string",
          "const": "Field"
        }
      ]
    },
    "OutLevel": {
      "description": "An active's output level. No real source gives the level at the band's top, so the\nrecord says where it was read.",
      "type": "object",
      "properties": {
        "f_ref_mhz": {
          "description": "Where it was read, MHz.",
          "type": "number",
          "format": "double"
        },
        "out_level_dbmv": {
          "description": "Level at `f_ref_mhz`, dBmV per 6 MHz.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "out_level_dbmv",
        "f_ref_mhz"
      ]
    },
    "PortId": {
      "description": "A port on one element, such as `tap-1` or `through`.",
      "type": "string"
    },
    "PortOutLevel": {
      "description": "One output port's level (§15). Version 2.",
      "type": "object",
      "properties": {
        "f_ref_mhz": {
          "description": "Where it was read, MHz.",
          "type": "number",
          "format": "double"
        },
        "out_level_dbmv": {
          "description": "Level at `f_ref_mhz`, dBmV per 6 MHz.",
          "type": "number",
          "format": "double"
        },
        "port": {
          "description": "The output port.",
          "$ref": "#/$defs/PortId"
        }
      },
      "additionalProperties": false,
      "required": [
        "port",
        "out_level_dbmv",
        "f_ref_mhz"
      ]
    },
    "Timestamp": {
      "description": "Simulated time in seconds, passed in and never read from the system clock\n(invariant 4). t = 0 is midnight on the simulated day (§8).",
      "type": "integer",
      "format": "int64"
    }
  }
}
