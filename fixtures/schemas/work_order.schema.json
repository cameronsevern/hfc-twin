{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkOrder",
  "description": "One fix to one problem.",
  "type": "object",
  "properties": {
    "action": {
      "description": "What to do, from the policy table.",
      "type": "string"
    },
    "affected_modems": {
      "description": "Number of modems affected.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "cause": {
      "description": "The diagnosed cause.",
      "$ref": "#/$defs/CauseClass"
    },
    "confidence": {
      "description": "Posterior probability of this cause, 0 to 1.",
      "type": "number",
      "format": "float"
    },
    "element_id": {
      "description": "The element to go to.",
      "$ref": "#/$defs/ElementId"
    },
    "explanation": {
      "description": "Why, rendered from a template rather than generated.",
      "type": "string"
    },
    "geo": {
      "description": "Where that element is, if known.",
      "anyOf": [
        {
          "$ref": "#/$defs/LonLat"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "See [`WorkOrder::derive_id`].",
      "type": "string",
      "format": "uuid"
    },
    "parameters": {
      "description": "The fault parameters that best explain the telemetry.",
      "$ref": "#/$defs/Fault"
    },
    "parts": {
      "description": "Parts to bring, from the policy table.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    },
    "service_group": {
      "description": "The service group affected.",
      "$ref": "#/$defs/ServiceGroupId"
    },
    "status": {
      "description": "Where the work order is in its lifecycle.",
      "$ref": "#/$defs/WorkOrderStatus"
    },
    "t": {
      "description": "Simulated time of the diagnosis, seconds.",
      "$ref": "#/$defs/Timestamp"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "service_group",
    "t",
    "element_id",
    "cause",
    "parameters",
    "confidence",
    "affected_modems",
    "action",
    "parts",
    "explanation",
    "status"
  ],
  "$defs": {
    "AmpState": {
      "description": "The state of a drifting or failed amp.",
      "oneOf": [
        {
          "description": "Output and, above an onset level, distortion have moved (§4.4).",
          "type": "object",
          "properties": {
            "Drift": {
              "type": "object",
              "properties": {
                "compression_onset_dbmv": {
                  "description": "Output level above which CIN degrades further, dBmV per 6 MHz at the band's\ntop frequency, or `None` for no compression.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "gain_delta_db": {
                  "description": "Change in gain, dB.",
                  "type": "number",
                  "format": "double"
                },
                "tilt_delta_db": {
                  "description": "Change in tilt, dB.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "gain_delta_db",
                "tilt_delta_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Drift"
          ]
        },
        {
          "description": "No output. An explicit state, because JSON cannot carry −∞.",
          "type": "string",
          "const": "Failed"
        }
      ]
    },
    "Burst": {
      "description": "The time structure of bursty ingress.",
      "type": "object",
      "properties": {
        "duration_ms": {
          "description": "Length of one burst, milliseconds.",
          "type": "number",
          "format": "double"
        },
        "rate_per_s": {
          "description": "Bursts per second.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "rate_per_s"
      ]
    },
    "CauseClass": {
      "description": "What caused a problem: one variant per fault class in §8, plus `Unknown`.",
      "oneOf": [
        {
          "description": "`FaultKind::WaterIngress`.",
          "type": "string",
          "const": "WaterIngress"
        },
        {
          "description": "`FaultKind::ConnectorReflection`.",
          "type": "string",
          "const": "ConnectorReflection"
        },
        {
          "description": "`FaultKind::Suckout`.",
          "type": "string",
          "const": "Suckout"
        },
        {
          "description": "`FaultKind::FrequencySelectiveLoss`.",
          "type": "string",
          "const": "FrequencySelectiveLoss"
        },
        {
          "description": "`FaultKind::AmpDrift`.",
          "type": "string",
          "const": "AmpDrift"
        },
        {
          "description": "`FaultKind::UpstreamIngress`.",
          "type": "string",
          "const": "UpstreamIngress"
        },
        {
          "description": "`FaultKind::DownstreamIngress`.",
          "type": "string",
          "const": "DownstreamIngress"
        },
        {
          "description": "`FaultKind::PowerSupplySag`.",
          "type": "string",
          "const": "PowerSupplySag"
        },
        {
          "description": "`FaultKind::ResonantPeak`.",
          "type": "string",
          "const": "ResonantPeak"
        },
        {
          "description": "`FaultKind::AdjacentLevelOffset`.",
          "type": "string",
          "const": "AdjacentLevelOffset"
        },
        {
          "description": "`FaultKind::ForwardOptics`.",
          "type": "string",
          "const": "ForwardOptics"
        },
        {
          "description": "`FaultKind::CommonPathDistortion`.",
          "type": "string",
          "const": "CommonPathDistortion"
        },
        {
          "description": "`FaultKind::BadDrop`.",
          "type": "string",
          "const": "BadDrop"
        },
        {
          "description": "An RPD stopped.",
          "type": "string",
          "const": "RpdFailure"
        },
        {
          "description": "The fiber to an RPD is cut.",
          "type": "string",
          "const": "CinLinkCut"
        },
        {
          "description": "The control plane to an RPD is lost.",
          "type": "string",
          "const": "GcpLoss"
        },
        {
          "description": "An RPD lost its timing.",
          "type": "string",
          "const": "TimingLoss"
        },
        {
          "description": "An RPD's RF output is set wrong.",
          "type": "string",
          "const": "RfmMisalignment"
        },
        {
          "description": "A fault inside one home, past its ground block: a part, a connector or the cable between them. Version 5.",
          "type": "string",
          "const": "InHomeWiring"
        },
        {
          "description": "`FaultKind::Misalignment`: a wrong pad or equalizer at a fitted active. Version 5.",
          "type": "string",
          "const": "Misalignment"
        },
        {
          "description": "`FiberFaultKind::FiberCut`. Version 5.",
          "type": "string",
          "const": "FiberCut"
        },
        {
          "description": "`FiberFaultKind::EventLoss`: a lossy splice, connector or bend. Version 5.",
          "type": "string",
          "const": "FiberEventLoss"
        },
        {
          "description": "`FiberFaultKind::TransmitterDrift`. Version 5.",
          "type": "string",
          "const": "OpticalTransmitterDrift"
        },
        {
          "description": "No fault class explains the telemetry.",
          "type": "string",
          "const": "Unknown"
        }
      ]
    },
    "ConnectorCouplings": {
      "description": "A connector fault's couplings to the environment (§18, §19). Each absent is none. Version 4.",
      "type": "object",
      "properties": {
        "ambient_coupling_db": {
          "description": "Coupling of ambient sources in at this point, dB, where the defect has opened the shield (§18).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "temp_db_per_c": {
          "description": "Change in return loss per °C above 20 °C at the connector, dB: positive for a joint that loosens as it cools.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "wind_db_per_m_per_s": {
          "description": "Change in return loss per m/s of wind, dB: negative for a joint that moves when the cable does.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "CutEnd": {
      "description": "How a cut cable's live side ends (§20.1). Version 5.",
      "oneOf": [
        {
          "description": "The conductors parted: an open, reflecting in phase.",
          "type": "string",
          "const": "Open"
        },
        {
          "description": "Center conductor against the shield: a short, reflecting inverted, and a path for the AC (§20.4).",
          "type": "string",
          "const": "Shorted"
        }
      ]
    },
    "EdgeId": {
      "description": "A plant edge. A fault's `span_id` is one of these (§8).",
      "type": "string"
    },
    "ElementId": {
      "description": "A plant element or power supply, such as `amp-1`.",
      "type": "string"
    },
    "Fault": {
      "description": "One fault.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The fault class and its parameters.",
          "$ref": "#/$defs/FaultKind"
        },
        "onset": {
          "description": "When the fault appears.",
          "$ref": "#/$defs/Onset"
        }
      },
      "additionalProperties": false,
      "required": [
        "onset",
        "kind"
      ]
    },
    "FaultKind": {
      "description": "The fault classes of §8.",
      "oneOf": [
        {
          "description": "Water in a span: added loss and non-periodic impedance variation.",
          "type": "object",
          "properties": {
            "WaterIngress": {
              "type": "object",
              "properties": {
                "affected_len_ft": {
                  "description": "Affected length, feet.",
                  "type": "number",
                  "format": "double"
                },
                "impedance_variation_pct": {
                  "description": "Size of the seeded impedance variation, percent.",
                  "type": "number",
                  "format": "double"
                },
                "k_w_db_per_100ft": {
                  "description": "`k_w`: added loss at 1 GHz, dB per 100 ft.",
                  "type": "number",
                  "format": "double"
                },
                "pos_ft": {
                  "description": "Where the affected length starts, feet from the span's upstream end.",
                  "type": "number",
                  "format": "double"
                },
                "rain_coupling_per_mm_per_hr": {
                  "description": "Rise in `k_w` per unit of rainfall, per mm per hour.",
                  "type": "number",
                  "format": "double"
                },
                "span_id": {
                  "description": "The span.",
                  "$ref": "#/$defs/EdgeId"
                }
              },
              "required": [
                "span_id",
                "pos_ft",
                "affected_len_ft",
                "k_w_db_per_100ft",
                "rain_coupling_per_mm_per_hr",
                "impedance_variation_pct"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "WaterIngress"
          ]
        },
        {
          "description": "A mismatch at a connector; echoes follow from §5.1.",
          "type": "object",
          "properties": {
            "ConnectorReflection": {
              "type": "object",
              "properties": {
                "couplings": {
                  "description": "How the mismatch moves with the environment, and whether it lets ambient in (§18, §19). Version 4.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ConnectorCouplings"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "location": {
                  "description": "Where the mismatch is.",
                  "$ref": "#/$defs/Location"
                },
                "return_loss_db": {
                  "description": "Return loss of the mismatch, dB, at 20 °C and calm.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "location",
                "return_loss_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ConnectorReflection"
          ]
        },
        {
          "description": "A narrow minimum-phase loss.",
          "type": "object",
          "properties": {
            "Suckout": {
              "type": "object",
              "properties": {
                "depth_db": {
                  "description": "Loss at the centre, dB.",
                  "type": "number",
                  "format": "double"
                },
                "f0_mhz": {
                  "description": "Centre frequency, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "location": {
                  "description": "Where the loss is.",
                  "$ref": "#/$defs/Location"
                },
                "width_mhz": {
                  "description": "Offset from centre at which the dB depth falls to 1/e, MHz.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "location",
                "f0_mhz",
                "depth_db",
                "width_mhz"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Suckout"
          ]
        },
        {
          "description": "Shaped minimum-phase loss: traps, filters, pullout and under-rated parts.",
          "type": "object",
          "properties": {
            "FrequencySelectiveLoss": {
              "type": "object",
              "properties": {
                "depth_db": {
                  "description": "Loss in the stop band, dB.",
                  "type": "number",
                  "format": "double"
                },
                "f_hi_mhz": {
                  "description": "Upper edge, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "f_lo_mhz": {
                  "description": "Lower edge, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "location": {
                  "description": "Where the loss is.",
                  "$ref": "#/$defs/Location"
                },
                "shape": {
                  "description": "The shape of the loss.",
                  "$ref": "#/$defs/LossShape"
                },
                "skirt_mhz": {
                  "description": "Width over which the loss ramps in, MHz, or `None` for a sharp edge.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double",
                  "default": null
                },
                "stop_return_loss_db": {
                  "description": "Return loss in the stop band, dB.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "location",
                "shape",
                "f_lo_mhz",
                "f_hi_mhz",
                "depth_db",
                "stop_return_loss_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "FrequencySelectiveLoss"
          ]
        },
        {
          "description": "An amp drifting out of alignment or failing.",
          "type": "object",
          "properties": {
            "AmpDrift": {
              "type": "object",
              "properties": {
                "amp_id": {
                  "description": "The amp.",
                  "$ref": "#/$defs/ElementId"
                },
                "state": {
                  "description": "What has happened to it.",
                  "$ref": "#/$defs/AmpState"
                }
              },
              "required": [
                "amp_id",
                "state"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AmpDrift"
          ]
        },
        {
          "description": "Noise injected into the return path; funnels per §7.3.",
          "type": "object",
          "properties": {
            "UpstreamIngress": {
              "type": "object",
              "properties": {
                "burst": {
                  "description": "Burst structure, or `None` for continuous noise.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Burst"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bw_mhz": {
                  "description": "Bandwidth, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "entry_location": {
                  "description": "Where the noise enters.",
                  "$ref": "#/$defs/Location"
                },
                "f_mhz": {
                  "description": "Centre frequency, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "power_dbmv": {
                  "description": "Total power in `bw_mhz`, dBmV.",
                  "type": "number",
                  "format": "double"
                },
                "schedule": {
                  "description": "Time-of-day profile.",
                  "$ref": "#/$defs/Schedule"
                }
              },
              "required": [
                "entry_location",
                "f_mhz",
                "bw_mhz",
                "power_dbmv",
                "schedule"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "UpstreamIngress"
          ]
        },
        {
          "description": "Noise injected into the forward path (§4.5).",
          "type": "object",
          "properties": {
            "DownstreamIngress": {
              "type": "object",
              "properties": {
                "bw_mhz": {
                  "description": "Bandwidth, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "entry_location": {
                  "description": "Where the noise enters.",
                  "$ref": "#/$defs/Location"
                },
                "f_mhz": {
                  "description": "Centre frequency, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "power_dbmv": {
                  "description": "Total power in `bw_mhz`, dBmV.",
                  "type": "number",
                  "format": "double"
                },
                "schedule": {
                  "description": "Time-of-day profile.",
                  "$ref": "#/$defs/Schedule"
                }
              },
              "required": [
                "entry_location",
                "f_mhz",
                "bw_mhz",
                "power_dbmv",
                "schedule"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "DownstreamIngress"
          ]
        },
        {
          "description": "A power supply running low; brownouts follow per §6.3.",
          "type": "object",
          "properties": {
            "PowerSupplySag": {
              "type": "object",
              "properties": {
                "psu_id": {
                  "description": "The power supply.",
                  "$ref": "#/$defs/ElementId"
                },
                "schedule": {
                  "description": "Time-of-day profile.",
                  "$ref": "#/$defs/Schedule"
                },
                "v_delta": {
                  "description": "Fall in supply voltage, volts.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "psu_id",
                "v_delta",
                "schedule"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "PowerSupplySag"
          ]
        },
        {
          "description": "Loss on one drop only.",
          "type": "object",
          "properties": {
            "BadDrop": {
              "type": "object",
              "properties": {
                "extra_loss_db": {
                  "description": "Added loss, dB.",
                  "type": "number",
                  "format": "double"
                },
                "modem_id": {
                  "description": "The modem at the end of the drop.",
                  "$ref": "#/$defs/ElementId"
                },
                "return_loss_db": {
                  "description": "Return loss of an added mismatch, dB, or `None` for no mismatch.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                }
              },
              "required": [
                "modem_id",
                "extra_loss_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "BadDrop"
          ]
        },
        {
          "description": "Frequency-specific gain from feedback inside an amp [PNM-HFC §7.1.5].",
          "type": "object",
          "properties": {
            "ResonantPeak": {
              "type": "object",
              "properties": {
                "amp_id": {
                  "description": "The amp.",
                  "$ref": "#/$defs/ElementId"
                },
                "f0_mhz": {
                  "description": "Centre frequency, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "gain_db": {
                  "description": "Rise at the centre, dB.",
                  "type": "number",
                  "format": "double"
                },
                "width_mhz": {
                  "description": "Offset from centre at which the dB rise falls to 1/e, MHz.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "amp_id",
                "f0_mhz",
                "gain_db",
                "width_mhz"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ResonantPeak"
          ]
        },
        {
          "description": "A block of channels combined at the wrong level at the head end or node [PNM-HFC §7.1.1].",
          "type": "object",
          "properties": {
            "AdjacentLevelOffset": {
              "type": "object",
              "properties": {
                "f_hi_mhz": {
                  "description": "Upper edge, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "f_lo_mhz": {
                  "description": "Lower edge, MHz.",
                  "type": "number",
                  "format": "double"
                },
                "offset_db": {
                  "description": "Level change, dB.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "f_lo_mhz",
                "f_hi_mhz",
                "offset_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AdjacentLevelOffset"
          ]
        },
        {
          "description": "A worse forward optical link: laser, connector or clipping, seen as noise (§8).",
          "type": "object",
          "properties": {
            "ForwardOptics": {
              "type": "object",
              "properties": {
                "cnr_loss_db": {
                  "description": "Fall in `CNR_opt`, dB.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "cnr_loss_db"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ForwardOptics"
          ]
        },
        {
          "description": "A corroded contact mixing the forward signals into the return path [PNM-HFC §8.16.1.1].",
          "type": "object",
          "properties": {
            "CommonPathDistortion": {
              "type": "object",
              "properties": {
                "location": {
                  "description": "Where the contact is.",
                  "$ref": "#/$defs/Location"
                },
                "schedule": {
                  "description": "Time-of-day profile.",
                  "$ref": "#/$defs/Schedule"
                },
                "second_order_dbmv_per_mhz": {
                  "description": "Second-order product density at its largest, dBmV per MHz.",
                  "type": "number",
                  "format": "double"
                },
                "third_over_second_db": {
                  "description": "Third-order density at its largest against the second order's, dB.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "location",
                "second_order_dbmv_per_mhz",
                "third_over_second_db",
                "schedule"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "CommonPathDistortion"
          ]
        },
        {
          "description": "An RPD stopped: power, crash or reset [R-PHY §6.3, §8].",
          "type": "object",
          "properties": {
            "RpdFailure": {
              "type": "object",
              "properties": {
                "mode": {
                  "description": "How it failed.",
                  "$ref": "#/$defs/RpdFailureMode"
                },
                "rpd_id": {
                  "description": "The RPD.",
                  "$ref": "#/$defs/ElementId"
                }
              },
              "required": [
                "rpd_id",
                "mode"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "RpdFailure"
          ]
        },
        {
          "description": "The fiber to an RPD is cut. It stays alive and powered, and its RF stops.",
          "type": "object",
          "properties": {
            "CinLinkCut": {
              "type": "object",
              "properties": {
                "repair_s": {
