{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Region",
  "description": "A region: many nodes on one map.",
  "type": "object",
  "properties": {
    "fiber_ref": {
      "description": "The id of its fiber plant, a `schema::fiber::FiberPlant`. Version 2.",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Stable identifier.",
      "type": "string"
    },
    "map_id": {
      "description": "The map it's on.",
      "type": "string"
    },
    "nodes": {
      "description": "Its nodes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegionNode"
      }
    },
    "origin": {
      "description": "Whether it's simulated or real (invariant 11).",
      "$ref": "#/$defs/Origin"
    },
    "schema_version": {
      "description": "Version of this schema.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "map_id",
    "origin",
    "nodes"
  ],
  "$defs": {
    "Origin": {
      "description": "Whether a plant or observation is simulated or measured (invariant 11).",
      "oneOf": [
        {
          "description": "Generated by this project; never to be presented as real.",
          "type": "string",
          "const": "Synthetic"
        },
        {
          "description": "Measured on, or imported from, a real network.",
          "type": "string",
          "const": "Field"
        }
      ]
    },
    "ProfileId": {
      "description": "An architecture profile.",
      "type": "string"
    },
    "RegionNode": {
      "description": "One node in a region.",
      "type": "object",
      "properties": {
        "homes_passed": {
          "description": "Homes it passes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile_ref": {
          "description": "The profile it runs.",
          "$ref": "#/$defs/ProfileId"
        },
        "service_group": {
          "description": "Its service group, whose plant is its own file.",
          "$ref": "#/$defs/ServiceGroupId"
        }
      },
      "additionalProperties": false,
      "required": [
        "service_group",
        "profile_ref",
        "homes_passed"
      ]
    },
    "ServiceGroupId": {
      "description": "A service group: one node's tree.",
      "type": "string"
    }
  }
}
